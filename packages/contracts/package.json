{
  "name": "@ahead/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "default": "./dist/mocks/index.js"
    },
    "./mocks/node": {
      "types": "./dist/mocks/node.d.ts",
      "default": "./dist/mocks/node.js"
    },
    "./mocks/fixtures/*.json": "./dist/mocks/fixtures/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "mkdir -p dist/mocks && cp -R mocks/fixtures dist/mocks/",
    "lint": "eslint . && tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "vitest": "4.1.12"
  }
}
